# ========================================
# PENTAGO SERVER - ENVIRONMENT VARIABLES
# ========================================

# SERVER CONFIGURATION
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000

# MONGODB CONFIGURATION
MONGODB_URI=mongodb://localhost:27017/pentago
MONGODB_URI_TEST=mongodb://localhost:27017/pentago_test

# JWT AUTHENTICATION
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# BCRYPT
BCRYPT_SALT_ROUNDS=10

# FFMPEG CONFIGURATION
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# VIDEO RECORDING SETTINGS
VIDEO_FPS=24
VIDEO_BITRATE=4000k
AUDIO_SAMPLE_RATE=44100
AUDIO_BITRATE=128k
VIDEO_FORMAT=webm

# STORAGE LIMITS
MAX_VIDEO_AGE_DAYS=15
MAX_VIDEO_SIZE_GB=1
MAX_UPLOAD_SIZE_MB=10

# GAME SETTINGS
MAX_QUEUE_SIZE=25
INACTIVITY_TIMEOUT_SECONDS=60
MAX_GAME_DURATION_MINUTES=60

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ADMIN
ADMIN_EMAIL=admin@pentago.com
ADMIN_PASSWORD=change_this_password

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# SESSION
SESSION_SECRET=your_session_secret_here_change_this

# LOGS
LOG_LEVEL=info
LOG_FILE=logs/server.log

# CLEANUP SERVICE
CLEANUP_INTERVAL_HOURS=24
